# Media Stack Environment Variables
# Copy this to .env and fill in required values.
# These map to the Komodo stack environment (runtime vars + build args).

# ==============================================================================
# LIVE SPORTS
# ==============================================================================

# Hostname for Live Sports addon
# LIVE_SPORTS_HOST=live-sports.fewa.app

# Upstream ref to pin (default main)
# LIVE_SPORTS_REF=main

# ==============================================================================
# ARVIO (Browser media hub)
# ==============================================================================

# Hostname for ARVIO (compose maps to traefik router)
# ARVIO_HOST=arvio.fewa.app

# Upstream ARVIO ref to pin (default main)
# ARVIO_REF=main

# TMDB API v3 key (REQUIRED for built-in movie/show catalogs)
# TMDB_API_KEY=

# Optional Trakt integration
# TRAKT_CLIENT_ID=
# TRAKT_CLIENT_SECRET=

# Optional Simkl integration
# SIMKL_CLIENT_ID=
# SIMKL_CLIENT_SECRET=

# Optional Telegram application credentials (browser-visible, never a bot token)
# NEXT_PUBLIC_TELEGRAM_API_ID=
# NEXT_PUBLIC_TELEGRAM_API_HASH=

# Advanced: URL of your own compatible resolver, if you deploy one
# NEXT_PUBLIC_ARVIO_RESOLVER_URL=

# Allow server-side access to LAN home-server APIs (e.g. Plex/Emby/Jellyfin).
# Only enable on a trusted, authenticated installation.
# ALLOW_PRIVATE_PROXY=false
