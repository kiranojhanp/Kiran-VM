# Papra Environment Variables
# Copy this to .env and fill in required values
# Deploy with: docker compose --env-file .env up -d

# ==============================================================================
# REQUIRED
# ==============================================================================

# Hostname (FQDN) for Papra
# PAPRA_HOST=papra.fewa.app

# Auth secret for Papra — generate with: openssl rand -hex 32
# Must be stable across restarts to preserve sessions.
# PAPRA_AUTH_SECRET=

# ==============================================================================
# OPTIONAL (defaults shown)
# ==============================================================================

# Timezone (default: UTC)
# TZ=UTC

# Shared Docker network (default: internal-network)
# SHARED_DOCKER_NETWORK=internal-network

# ==============================================================================
# INTAKE EMAILS (optional, disabled by default)
# ==============================================================================

# Enable email intake for documents (default: false)
# INTAKE_EMAILS_IS_ENABLED=false

# Intake email driver: owlrelay or catch-all (default: owlrelay)
# INTAKE_EMAILS_DRIVER=owlrelay

# API key used to interact with OwlRelay for intake emails
# OWLRELAY_API_KEY=

# Secret to verify intake email webhooks (random string, 16-128 chars)
# INTAKE_EMAILS_WEBHOOK_SECRET=

# Webhook URL for OwlRelay intake emails (inferred from server URL if omitted)
# OWLRELAY_WEBHOOK_URL=