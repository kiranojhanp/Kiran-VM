# Papra Environment Variables
# Copy this to .env and fill in required values
# Deploy with: docker compose --env-file .env up -d

# ==============================================================================
# REQUIRED
# ==============================================================================

# Hostname (FQDN) for Papra
# PAPRA_HOST=papra.fewa.app

# Auth secret for Papra — generate with: openssl rand -hex 32
# Must be stable across restarts to preserve sessions.
# PAPRA_AUTH_SECRET=

# ==============================================================================
# OPTIONAL (defaults shown)
# ==============================================================================

# Timezone (default: UTC)
# TZ=UTC

# Shared Docker network (default: internal-network)
# SHARED_DOCKER_NETWORK=internal-network